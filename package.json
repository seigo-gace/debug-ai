{
  "name":"debug-ai",
  "private":true,
  "version":"0.3.0-server",
  "bin":{"debugai":"bin/debugai.js","debugai-mcp":"bin/debugai-mcp.mjs"},
  "engines":{"node":"24.20.0"},
  "dependencies":{"@modelcontextprotocol/server":"2.2.0","typescript":"7.0.2","undici":"8.11.2","zod":"4.6.5"},
  "devDependencies":{"@modelcontextprotocol/client":"2.3.1"},
  "scripts":{
    "build:durable-native":"node scripts/build-durable-native.cjs",
    "check":"find server orchestrator tests mcp bin -type f \\( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \\) -print0 | xargs -0 -n1 node --check",
    "test":"node --test tests/*.test.cjs server/tests/*.test.cjs mcp/tests/*.test.mjs",
    "verify":"npm run build:durable-native && npm run check && npm test",
    "verify:core":"npm run build:durable-native && npm run check && npm test",
    "debugai":"node bin/debugai.js",
    "debugai:mcp":"node bin/debugai-mcp.mjs",
    "test:e2e-fixture":"node --test server/tests/full-debugai-e2e-fixture.test.cjs",
    "test:legacy":"node --test legacy/pc-authority/orchestrator/tests/*.cjs legacy/pc-authority/gateway/*.test.mjs",
    "benchmark:local-reviewer":"node server/control/local-reviewer-benchmark.js",
    "benchmark:skill-effect":"node server/control/skill-effect-benchmark.js",
    "benchmark:code-scout-skill-effect":"node server/control/code-scout-skill-effect-benchmark.js",
    "benchmark:causal-scout-skill-effect":"node server/control/causal-scout-skill-effect-benchmark.js",
    "benchmark:researcher-skill-effect":"node server/control/researcher-skill-effect-benchmark.js",
    "benchmark:diagnoser-skill-effect":"node server/control/diagnoser-skill-effect-benchmark.js",
    "benchmark:patch-engineer-skill-effect":"node server/control/patch-engineer-skill-effect-benchmark.js",
    "audit:control-plane-gaps":"node server/control/control-plane-gap-audit.js",
    "audit:docker-storage":"node scripts/docker-storage-audit.cjs",
    "start":"node server/main.js"
  }
}
