DEBUG_AI_CORE_URL=http://127.0.0.1:18080
AI_CORE_API_KEY=
# Required for production DebugAI execution. Set only from measured AI Core runtime n_ctx; do not infer it from model-native capability.
DEBUG_AI_CORE_CONTEXT_TOKENS=
DEBUG_AI_EVIDENCE_SEARCH_URL=http://127.0.0.1:7376
DEBUG_AI_EVIDENCE_SEARCH_SECRET_HOST_PATH=
DEBUG_AI_EVIDENCE_SEARCH_CALLER_ID=debug-ai
DEBUG_AI_TGSERVER_URL=http://127.0.0.1:3000
DEBUG_AI_TGSERVER_LOG_PROJECT_ID=P004
DEBUG_AI_TGSERVER_KB_PROJECT_ID=P005
# Runtime logs are queued and sent in bounded background batches so TGserver latency never blocks DebugAI workflow execution.
DEBUG_AI_TGSERVER_LOG_TIMEOUT_MS=250
DEBUG_AI_TGSERVER_LOG_QUEUE_SIZE=2048
DEBUG_AI_TGSERVER_LOG_BATCH_SIZE=32
DEBUG_AI_REPO_ALLOWLIST=repo-a,repo-b
DEBUG_AI_WORKSPACE_HOST_PATH=/srv/debug-ai/workspace
DEBUG_AI_OSV_DB_HOST_PATH=/var/lib/debug-ai/osv-db
DEBUG_AI_TOOLS_HOST_PATH=/opt/debug-ai/tools
DEBUG_AI_RUNTIME_EVIDENCE_RETENTION_MS=43200000
DEBUG_AI_RUNTIME_EVIDENCE_MAX_BYTES=33554432
DEBUG_AI_RUNTIME_EVIDENCE_ROTATE_MS=900000
DEBUG_AI_ARCHIVE_SWEEP_MS=1800000
DEBUG_AI_ARCHIVE_INITIAL_DELAY_MS=60000
DEBUG_AI_ARCHIVE_MAX_RUNS=4
GROQ_API_KEY=
GEMINI_API_KEY=
DEBUG_AI_GROQ_URL=
DEBUG_AI_GEMINI_URL=
# FREE qualification is UNKNOWN by default: keys/booleans NEVER enable provider HTTP.
# Host-owned account audit file; protected read-only mounting requires Host admission.
DEBUG_AI_EXTERNAL_REVIEW_FREE_QUALIFICATION_FILE=
# Ledger defaults to ${DEBUG_AI_RUNTIME_ROOT}/external-review-quota in the Compose volume.
# Legacy DEBUG_AI_EXTERNAL_REVIEW_QUOTA_DIR must be reconciled; do not migrate/reset silently.
# Local rolling hard ceilings below may only be lowered. Actual account allocations also apply.
DEBUG_AI_GROQ_MINUTE_REQUEST_LIMIT=1
DEBUG_AI_GROQ_HOUR_REQUEST_LIMIT=2
DEBUG_AI_GROQ_DAILY_REQUEST_LIMIT=4
DEBUG_AI_GROQ_MONTH_REQUEST_LIMIT=20
DEBUG_AI_GEMINI_MINUTE_REQUEST_LIMIT=1
DEBUG_AI_GEMINI_HOUR_REQUEST_LIMIT=2
DEBUG_AI_GEMINI_DAILY_REQUEST_LIMIT=4
DEBUG_AI_GEMINI_MONTH_REQUEST_LIMIT=20
